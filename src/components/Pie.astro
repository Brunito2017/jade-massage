---
import { MAPS, SITE, whatsappLink } from '../data/site';

/**
 * Pie de sitio.
 *
 * Los tres canales van como iconos y no como texto. El pie es el último bloque
 * de cada página y la lista "teléfono / Instagram / Cómo llegar" competía en
 * lectura con los enlaces de servicios: tres filas de texto para tres acciones
 * que un icono resuelve de un vistazo. Cada botón conserva su nombre accesible
 * y su tooltip, así que sigue funcionando con lector de pantalla y con teclado.
 *
 * La dirección se queda como texto a propósito: es el NAP que Google cruza con
 * la ficha del Google Business Profile y no puede depender de un icono.
 */
---

<footer class="pie">
  <div class="pie__contenido">
    <div class="pie__marca">
      <p class="pie__nombre">{SITE.nombre}</p>
      <p class="pie__descripcion">
        Masoterapia clínica y estética integral en {SITE.comuna}, Santiago.
      </p>
    </div>

    <nav aria-label="Servicios">
      <p class="pie__titulo">Servicios</p>
      <ul class="pie__lista">
        <li>
          <a href="/servicios/masaje-descontracturante/">Masaje descontracturante</a>
        </li>
        <li><a href="/servicios/drenaje-linfatico/">Drenaje linfático</a></li>
        <li>
          <a href="/servicios/limpieza-facial-profunda/">Limpieza facial profunda</a>
        </li>
        <li><a href="/servicios/">Ver todos</a></li>
      </ul>
    </nav>

    <div>
      <p class="pie__titulo">Contacto</p>
      <ul class="pie__iconos">
        <li>
          <a
            class="pie__icono"
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            aria-label={`Escribir por WhatsApp al ${SITE.telefono}`}
            title="WhatsApp"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.22.2 2.42.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </li>
        <li>
          <a
            class="pie__icono"
            href={SITE.instagram}
            target="_blank"
            rel="noopener"
            aria-label={`Instagram de ${SITE.nombre}`}
            title="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <rect
                x="3.75"
                y="3.75"
                width="16.5"
                height="16.5"
                rx="4.5"
                stroke="currentColor"
                stroke-width="1.4"
              />
              <circle cx="12" cy="12" r="3.9" stroke="currentColor" stroke-width="1.4" />
              <circle cx="16.9" cy="7.1" r="0.9" fill="currentColor" />
            </svg>
          </a>
        </li>
        <li>
          <a
            class="pie__icono"
            href={MAPS.comoLlegar}
            target="_blank"
            rel="noopener"
            aria-label="Cómo llegar en Google Maps"
            title="Cómo llegar"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
              <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </a>
        </li>
      </ul>
      <address class="pie__direccion">
        {SITE.direccion.calle}<br />
        {SITE.direccion.comuna}, {SITE.direccion.region}
      </address>
    </div>
  </div>

  <div class="pie__base">
    <div class="pie__base-interior">
      <p>© {new Date().getFullYear()} {SITE.nombre}</p>
      <a href="/aviso-legal/">Aviso legal</a>
    </div>
  </div>
</footer>

<style>
  /* ============================================================
     BASE MÓVIL
     ============================================================ */

  .pie {
    background-color: var(--color-tierra-950);
    color: var(--color-crema-100);
  }

  .pie__contenido {
    display: grid;
    gap: 2.5rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.5rem 3.5rem;
  }

  .pie__nombre {
    margin-bottom: 0.85rem;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.05;
    color: var(--color-crema-50);
  }

  .pie__descripcion {
    max-width: 24rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: color-mix(in oklch, var(--color-crema-50) 60%, transparent);
  }

  /* La dirección cierra la columna de contacto, debajo del icono del pin. Es
     un dato de respaldo, no una llamada a la acción, así que va en el tono más
     bajo de la escala. */
  .pie__direccion {
    margin-top: 1.5rem;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: color-mix(in oklch, var(--color-crema-50) 40%, transparent);
  }

  .pie__titulo {
    margin-bottom: 1.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-crema-50) 40%, transparent);
  }

  .pie__lista {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    list-style: none;
    color: color-mix(in oklch, var(--color-crema-50) 65%, transparent);
  }

  .pie__lista a {
    position: relative;
    display: inline-block;
    padding-bottom: 2px;
    transition: color 0.3s var(--ease-suave);
  }

  /* El mismo subrayado que crece desde la izquierda que usan el logo, la intro
     y el cierre. */
  .pie__lista a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-suave);
  }

  .pie__iconos {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pie__icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in oklch, var(--color-crema-50) 22%, transparent);
    border-radius: 999px;
    color: color-mix(in oklch, var(--color-crema-50) 72%, transparent);
    transition:
      color 0.35s var(--ease-suave),
      border-color 0.35s var(--ease-suave),
      background-color 0.35s var(--ease-suave),
      translate 0.35s var(--ease-suave);
  }

  .pie__icono svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pie__icono:focus-visible,
  .pie__lista a:focus-visible,
  .pie__base a:focus-visible {
    outline: 2px solid var(--color-crema-50);
    outline-offset: 4px;
  }

  .pie__base {
    border-top: 1px solid color-mix(in oklch, var(--color-crema-50) 8%, transparent);
  }

  .pie__base-interior {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.25rem 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: color-mix(in oklch, var(--color-crema-50) 35%, transparent);
  }

  .pie__base a {
    transition: color 0.3s var(--ease-suave);
  }

  /* ============================================================
     TABLET / ESCRITORIO — marca ancha y dos columnas parejas
     ============================================================ */

  @media (min-width: 768px) {
    .pie__contenido {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 0.8fr);
      gap: 3rem;
      padding-block: 4rem;
    }

    .pie__base-interior {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (hover: hover) {
    .pie__lista a:hover {
      color: var(--color-crema-50);
    }

    .pie__lista a:hover::after {
      transform: scaleX(1);
    }

    .pie__icono:hover {
      border-color: color-mix(in oklch, var(--color-crema-50) 45%, transparent);
      background-color: color-mix(in oklch, var(--color-crema-50) 6%, transparent);
      color: var(--color-crema-50);
      translate: 0 -2px;
    }

    .pie__base a:hover {
      color: color-mix(in oklch, var(--color-crema-50) 70%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pie__lista a,
    .pie__lista a::after,
    .pie__icono,
    .pie__base a {
      transition: none;
    }
  }
</style>
