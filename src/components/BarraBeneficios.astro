---
/**
 * Barra de beneficios — tres promesas cortas con ícono, en una franja crema.
 *
 * Va dentro del cierre del hero, en la franja que abre la onda: el fondo es el
 * mismo color que la onda (crema-50, el fondo de página), así que la curva y la
 * franja se leen como una sola pieza. Por eso el componente se ocupa solo del
 * ancho — el alto y la separación del borde los pone el hero, que es quien sabe
 * cuánto mide la onda. Ver el slot `cierre` en Hero.astro.
 *
 * El contenido llega por prop — vive en la página, como en el resto del sitio.
 */
export type Icono = 'hoja' | 'loto' | 'corazon';

export interface Beneficio {
  icono: Icono;
  texto: string;
}

interface Props {
  beneficios: Beneficio[];
}

const { beneficios } = Astro.props;

/**
 * Íconos de línea, trazo fino, sin relleno. Dibujados a mano en un viewBox de
 * 24x24 para que escalen sin depender de una librería externa.
 */
const ICONOS: Record<Icono, string> = {
  // Hoja: dos curvas que se cruzan en las puntas + la nervadura central.
  hoja: `<path d="M20 4c0 9-7 16-16 16 0-9 7-16 16-16Z"/><path d="M7 17 17 7"/>`,

  // Loto: tres pétalos que nacen del mismo punto + el cuenco de la base.
  loto: `<path d="M12 4c1.8 2.4 2.7 4.5 2.7 6.4 0 1.9-1.2 3.3-2.7 3.3s-2.7-1.4-2.7-3.3C9.3 8.5 10.2 6.4 12 4Z"/><path d="M9.7 13.4C7.8 13 6.2 11.9 5.3 10.2 4.8 9.3 4.5 8.2 4.5 8.2s1.8 0 3 .6c1.7.8 2.9 2.3 3.3 4.1Z"/><path d="M14.3 13.4c1.9-.4 3.5-1.5 4.4-3.2.5-.9.8-2 .8-2s-1.8 0-3 .6c-1.7.8-2.9 2.3-3.3 4.1Z"/><path d="M6.5 15.8C8 17 9.9 17.6 12 17.6s4-.6 5.5-1.8"/>`,

  // Corazón: el trazo clásico de dos lóbulos.
  corazon: `<path d="M12 20.3S4 15.5 4 10.2C4 7.4 6.2 5.6 8.4 5.6c1.5 0 2.8.8 3.6 2 .8-1.2 2.1-2 3.6-2 2.2 0 4.4 1.8 4.4 4.6 0 5.3-8 10.1-8 10.1Z"/>`,
};
---

<div class="beneficios">
  <ul class="beneficios__lista">
    {
      beneficios.map((beneficio) => (
        <li class="beneficios__item">
          <span class="beneficios__icono" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={ICONOS[beneficio.icono]}
            />
          </span>
          <p class="beneficios__texto">{beneficio.texto}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* ============================================================
     BASE MÓVIL — tres columnas ya en el celular: los textos son de
     dos o tres palabras y entran sin apilar, igual que la referencia.
     ============================================================ */

  .beneficios {
    padding: 0 1.25rem;
  }

  .beneficios__lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 56rem;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }

  .beneficios__item {
    /* `--retraso` escalona las tres columnas sin repetir tres reglas */
    --retraso: 0s;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    padding: 0 0.5rem;
    text-align: center;
    animation: beneficio-entra 0.95s var(--ease-suave) backwards;
    animation-delay: calc(0.95s + var(--retraso));
  }

  .beneficios__item:nth-child(2) {
    --retraso: 0.12s;
  }

  .beneficios__item:nth-child(3) {
    --retraso: 0.24s;
  }

  @keyframes beneficio-entra {
    from {
      opacity: 0;
      translate: 0 0.9rem;
    }
  }

  /* Separador entre columnas. Es un pseudo-elemento y no un `border` porque una
     línea que se dibuja de arriba hacia abajo no se puede hacer con border. */
  .beneficios__item + .beneficios__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: color-mix(in oklch, var(--color-tierra-900) 14%, transparent);
    transform-origin: top;
    animation: beneficio-separador 0.85s var(--ease-suave) backwards;
    animation-delay: calc(1.15s + var(--retraso));
  }

  @keyframes beneficio-separador {
    from {
      scale: 1 0;
    }
  }

  .beneficios__icono {
    display: grid;
    place-items: center;
    /* El alto sale del mismo presupuesto que la franja: la parte sólida de la
       crema mide ~24vh (ver DivisorOnda), así que en ventanas bajas el ícono se
       achica solo antes que cruzar la curva. Lo que ocupan la separación, el
       texto y el aire contra el borde inferior son ~5rem — el aire lo pone el
       hero (ver .hero__cierre-contenido). */
    width: clamp(2.5rem, calc(14vh - 4rem), 3.5rem);
    aspect-ratio: 1;
    border-radius: 9999px;
    background-color: var(--color-crema-100);
    border: 1px solid color-mix(in oklch, var(--color-tierra-900) 14%, transparent);
    color: var(--color-tierra-900);
    /* El círculo florece un instante después de que la columna se posó */
    animation: beneficio-icono 0.9s var(--ease-suave) backwards;
    animation-delay: calc(1.05s + var(--retraso));
    translate: 0 0;
    transition:
      background-color 0.35s var(--ease-suave),
      border-color 0.35s var(--ease-suave),
      translate 0.35s var(--ease-suave);
  }

  @keyframes beneficio-icono {
    from {
      scale: 0.86;
    }
  }

  /* Solo donde hay puntero de verdad: en táctil el hover se queda pegado */
  @media (hover: hover) {
    .beneficios__item:hover .beneficios__icono {
      translate: 0 -3px;
      background-color: var(--color-crema-200);
      border-color: color-mix(in oklch, var(--color-tierra-900) 30%, transparent);
    }
  }

  /* El glifo acompaña al círculo, así que un solo clamp manda en el tamaño */
  .beneficios__icono svg {
    width: 55%;
    height: 55%;
  }

  .beneficios__texto {
    font-size: 0.68rem;
    line-height: 1.45;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-tierra-900);
  }

  /* ============================================================
     PANTALLAS GRANDES
     ============================================================ */

  @media (min-width: 768px) {
    .beneficios {
      padding: 0 2rem;
    }

    .beneficios__item {
      gap: 1.125rem;
    }

    .beneficios__texto {
      font-size: 0.8rem;
      letter-spacing: 0.16em;
    }
  }
</style>
