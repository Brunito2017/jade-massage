---
import HeroTexto from './HeroTexto.astro';
import DivisorOnda from './DivisorOnda.astro';
import { VARIANTES_HERO, type VarianteHero } from '../data/hero';

/**
 * Hero con variantes de composición sobre una misma estructura de markup.
 * La variante solo cambia el layout (CSS); el contenido es compartido.
 *
 * - `completo` — imagen a sangre completa, texto centrado encima.
 * - `marco`    — la imagen va enmarcada y se ve el color de página alrededor.
 * - `split`    — imagen y bloque de texto lado a lado, asimétrico.
 * - `bloque`   — imagen a sangre con una banda sólida que ancla el texto abajo.
 */
interface Props {
  variante?: VarianteHero;
  imagen: string;
  /** Texto alternativo. Vacío = imagen decorativa (el caso del hero). */
  imagenAlt?: string;
  eyebrow: string;
  titulo: string;
  subtitulo: string;
  ctaTexto: string;
  ctaHref: string;
  /** Fuerza el tono del texto en vez del que trae la variante. */
  tono?: 'claro' | 'oscuro';
  alineacion?: 'centro' | 'izquierda';
  /** Color con que la onda cierra el hero. Por defecto, el fondo de página. */
  colorOnda?: string;
}

const {
  variante = 'completo',
  imagen,
  imagenAlt = '',
  eyebrow,
  titulo,
  subtitulo,
  ctaTexto,
  ctaHref,
  tono,
  alineacion,
  colorOnda,
} = Astro.props;

const config = VARIANTES_HERO[variante];
---

<section class:list={['hero', `hero--${variante}`, { 'hero--con-onda': config.divisorOnda }]}>
  <div class="hero__media" aria-hidden="true">
    <img src={imagen} alt={imagenAlt} width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__velo"></div>
  </div>

  <div class="hero__panel">
    <div class="hero__inner">
      <HeroTexto
        eyebrow={eyebrow}
        titulo={titulo}
        subtitulo={subtitulo}
        ctaTexto={ctaTexto}
        ctaHref={ctaHref}
        tono={tono ?? config.tono}
        alineacion={alineacion ?? config.alineacion}
      />
    </div>
  </div>

  {
    config.divisorOnda && (
      <div class="hero__cierre">
        <DivisorOnda color={colorOnda} />
        {Astro.slots.has('cierre') && (
          <div class="hero__cierre-contenido">
            <slot name="cierre" />
          </div>
        )}
      </div>
    )
  }
</section>

<style>
  /* ============================================================
     BASE MÓVIL — todo lo de abajo sirve sin media queries.
     Los ajustes de pantallas grandes van con min-width.
     ============================================================ */

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-tierra-900);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La foto se asienta: entra un poco ampliada y se acomoda. Es lo más lento
       del hero a propósito — da la sensación de que la página respira antes de
       ponerse a hablar. */
    animation: hero-foto 2.4s var(--ease-suave) backwards;
  }

  @keyframes hero-foto {
    from {
      opacity: 0;
      transform: scale(1.05);
    }
  }

  /* Velo para que el texto se lea sobre cualquier foto */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-tierra-950) 55%, transparent),
      color-mix(in oklch, var(--color-tierra-950) 32%, transparent) 45%,
      color-mix(in oklch, var(--color-tierra-950) 72%, transparent)
    );
  }

  .hero__panel {
    position: relative;
    z-index: 2;
  }

  .hero__inner {
    width: 100%;
  }

  /* Reserva la parte de la onda que tapa la foto (--onda-relleno). El hero es
     un grid con place-items: center, así que este padding encoge el área útil
     hasta el borde de la curva: el texto queda centrado en la foto visible y
     nunca baja a la crema.
     Se descuenta solo el relleno y no --onda-alto entero porque el tramo por
     encima de la cresta sigue siendo foto: reservándolo todo, el texto se
     centraba sobre un área más chica que la foto y quedaba ~60px arriba. */
  .hero--con-onda {
    padding-bottom: calc(var(--onda-alto) * var(--onda-relleno));
  }

  /* ---------- completo: imagen a sangre, texto centrado  hola felipe ---------- */

  .hero--completo {
    display: grid;
    place-items: center;
  }

  .hero--completo .hero__panel {
    width: 100%;
    display: grid;
    place-items: center;
  }

  .hero--completo .hero__inner {
    max-width: 46rem;
    padding: 6.5rem 1.25rem 5.5rem;
  }

  /* ---------- marco: la imagen no toca los bordes ---------- */

  .hero--marco {
    background-color: var(--color-crema-100);
    padding: 0.75rem;
    display: flex;
  }

  .hero--marco .hero__media {
    inset: 0.75rem;
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .hero--marco .hero__panel {
    flex: 1;
    display: grid;
    place-items: center;
  }

  .hero--marco .hero__inner {
    max-width: 46rem;
    padding: 6rem 1rem 5rem;
  }

  /* ---------- split: imagen arriba, texto abajo ---------- */

  .hero--split {
    /* Esta variante usa header sólido, que ocupa 5rem en el flujo.
       Se descuentan para que el hero siga entrando en una pantalla. */
    min-height: calc(100vh - 5rem);
    min-height: calc(100svh - 5rem);
    background-color: var(--color-crema-50);
    display: grid;
    grid-template-rows: 42svh 1fr;
  }

  .hero--split .hero__media {
    position: relative;
    inset: auto;
  }

  .hero--split .hero__velo {
    display: none;
  }

  .hero--split .hero__panel {
    background-color: var(--color-crema-50);
    display: grid;
    place-items: center;
  }

  .hero--split .hero__inner {
    max-width: 34rem;
    padding: 2.75rem 1.5rem 3.5rem;
  }

  /* ---------- bloque: banda sólida anclada abajo ---------- */

  .hero--bloque {
    background-color: var(--color-tierra-900);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero--bloque .hero__panel {
    background-color: var(--color-tierra-950);
    padding: 2.5rem 1.5rem 2.75rem;
  }

  .hero--bloque .hero__inner {
    max-width: 46rem;
    margin: 0 auto;
  }

  /* ---------- cierre inferior: onda + franja que la onda abre ---------- */

  /* Caja que ocupa la franja de la onda, al pie del hero. La onda se ancla
     sola contra su borde inferior y mide lo mismo, así que la llena entera.
     El contenido del slot se apoya abajo, sobre la parte sólida de la crema.
     Es más alta que la reserva de .hero--con-onda: esa reserva es solo el
     relleno, porque por encima de la cresta la foto se sigue viendo. */
  .hero__cierre {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    height: var(--onda-alto);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* z-index por encima del 3 de la onda (DivisorOnda): si no, el relleno
     crema del SVG se pinta encima del contenido y lo tapa. */
  .hero__cierre-contenido {
    position: relative;
    z-index: 4;
    /* Aire bajo la franja. La crema sólida mide ~57% del alto de la onda, así
       que la mitad de lo que sobra es esto: la franja queda al medio de la
       parte sólida y no pegada al borde de la pantalla. Antes eran 1.5rem
       fijos, que en pantallas bajas dejaba los íconos casi tocando el borde. */
    padding-bottom: clamp(1.5rem, 5.5vh, 2.75rem);
  }

  /* ============================================================
     PANTALLAS GRANDES
     ============================================================ */

  @media (min-width: 768px) {
    .hero--completo .hero__inner {
      padding: 8rem 2rem 6.5rem;
    }

    .hero--marco {
      padding: 1.25rem;
    }

    .hero--marco .hero__media {
      inset: 1.25rem;
      border-radius: 0.5rem;
    }

    .hero--marco .hero__inner {
      padding: 7rem 2rem 6rem;
    }
  }

  /* El split pasa a dos columnas: texto a la izquierda, imagen a la derecha */
  @media (min-width: 900px) {
    .hero--split {
      grid-template-rows: none;
      grid-template-columns: 1fr 1.15fr;
    }

    .hero--split .hero__media {
      grid-column: 2;
      grid-row: 1;
    }

    .hero--split .hero__panel {
      grid-column: 1;
      grid-row: 1;
    }

    .hero--split .hero__inner {
      max-width: 31rem;
      padding: 7rem 3.5rem 4rem 3rem;
    }

    /* La banda pasa a ser una tarjeta flotante sobre la foto */
    .hero--bloque .hero__panel {
      width: min(92%, 46rem);
      margin: 0 auto 3rem;
      border-radius: 0.5rem;
      padding: 3rem 3.5rem;
      background-color: color-mix(in oklch, var(--color-tierra-950) 90%, transparent);
      backdrop-filter: blur(6px);
    }
  }

  /* ============================================================
     PANTALLAS BAJAS — que el hero entero entre en una pantalla
     ============================================================ */

  /* Un celular chico no da para el aire de siempre: con 6.5rem arriba y 5.5rem
     abajo, texto + onda + franja medían más que la pantalla. El hero crecía
     —`min-height`, no `height`— y la franja de íconos caía bajo el pliegue.
     Se recorta el aire vertical, no el contenido, y la franja vuelve a verse
     al abrir la página. Los 5.5rem de arriba son el mínimo que despeja el
     header, que va transparente encima de la foto.
     Va después del bloque de 768px para recortar también en ventanas bajas de
     escritorio; `padding-block` deja intacto el margen lateral de cada tamaño. */
  @media (max-height: 740px) {
    .hero--completo .hero__inner {
      padding-block: 5.5rem 2rem;
    }
  }

  /* Muy bajo (celular acostado): la onda se achica en global.css y la franja
     desaparece, en vez de quedar aplastada contra la curva. */
  @media (max-height: 520px) {
    .hero__cierre-contenido {
      display: none;
    }
  }
</style>
