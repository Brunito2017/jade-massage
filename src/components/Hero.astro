---
import HeroTexto from './HeroTexto.astro';
import { VARIANTES_HERO, type VarianteHero } from '../data/hero';

/**
 * Hero con variantes de composición sobre una misma estructura de markup.
 * La variante solo cambia el layout (CSS); el contenido es compartido.
 *
 * - `completo` — imagen a sangre completa, texto centrado encima.
 * - `marco`    — la imagen va enmarcada y se ve el color de página alrededor.
 * - `split`    — imagen y bloque de texto lado a lado, asimétrico.
 * - `bloque`   — imagen a sangre con una banda sólida que ancla el texto abajo.
 */
interface Props {
  variante?: VarianteHero;
  imagen: string;
  /** Texto alternativo. Vacío = imagen decorativa (el caso del hero). */
  imagenAlt?: string;
  eyebrow: string;
  titulo: string;
  subtitulo: string;
  ctaTexto: string;
  ctaHref: string;
  /** Ancla del indicador de scroll. Sin esto no se muestra. */
  anclaScroll?: string;
  /** Fuerza el tono del texto en vez del que trae la variante. */
  tono?: 'claro' | 'oscuro';
  alineacion?: 'centro' | 'izquierda';
}

const {
  variante = 'completo',
  imagen,
  imagenAlt = '',
  eyebrow,
  titulo,
  subtitulo,
  ctaTexto,
  ctaHref,
  anclaScroll,
  tono,
  alineacion,
} = Astro.props;

const config = VARIANTES_HERO[variante];
---

<section class:list={['hero', `hero--${variante}`]}>
  <div class="hero__media" aria-hidden="true">
    <img src={imagen} alt={imagenAlt} width="1920" height="1080" fetchpriority="high" decoding="async" />
    <div class="hero__velo"></div>
  </div>

  <div class="hero__panel">
    <div class="hero__inner">
      <HeroTexto
        eyebrow={eyebrow}
        titulo={titulo}
        subtitulo={subtitulo}
        ctaTexto={ctaTexto}
        ctaHref={ctaHref}
        tono={tono ?? config.tono}
        alineacion={alineacion ?? config.alineacion}
      />
    </div>
  </div>

  {
    anclaScroll && (
      <a class="hero__scroll" href={anclaScroll} aria-label="Ver servicios">
        <span class="hero__scroll-linea" aria-hidden="true" />
        <span class="hero__scroll-label">Servicios</span>
      </a>
    )
  }
</section>

<style>
  /* ============================================================
     BASE MÓVIL — todo lo de abajo sirve sin media queries.
     Los ajustes de pantallas grandes van con min-width.
     ============================================================ */

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-tierra-900);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Velo para que el texto se lea sobre cualquier foto */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--color-tierra-950) 55%, transparent),
      color-mix(in oklch, var(--color-tierra-950) 32%, transparent) 45%,
      color-mix(in oklch, var(--color-tierra-950) 72%, transparent)
    );
  }

  .hero__panel {
    position: relative;
    z-index: 2;
  }

  .hero__inner {
    width: 100%;
  }

  /* ---------- completo: imagen a sangre, texto centrado ---------- */

  .hero--completo {
    display: grid;
    place-items: center;
  }

  .hero--completo .hero__panel {
    width: 100%;
    display: grid;
    place-items: center;
  }

  .hero--completo .hero__inner {
    max-width: 46rem;
    padding: 6.5rem 1.25rem 5.5rem;
  }

  /* ---------- marco: la imagen no toca los bordes ---------- */

  .hero--marco {
    background-color: var(--color-crema-100);
    padding: 0.75rem;
    display: flex;
  }

  .hero--marco .hero__media {
    inset: 0.75rem;
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .hero--marco .hero__panel {
    flex: 1;
    display: grid;
    place-items: center;
  }

  .hero--marco .hero__inner {
    max-width: 46rem;
    padding: 6rem 1rem 5rem;
  }

  /* ---------- split: imagen arriba, texto abajo ---------- */

  .hero--split {
    /* Esta variante usa header sólido, que ocupa 5rem en el flujo.
       Se descuentan para que el hero siga entrando en una pantalla. */
    min-height: calc(100vh - 5rem);
    min-height: calc(100svh - 5rem);
    background-color: var(--color-crema-50);
    display: grid;
    grid-template-rows: 42svh 1fr;
  }

  .hero--split .hero__media {
    position: relative;
    inset: auto;
  }

  .hero--split .hero__velo {
    display: none;
  }

  .hero--split .hero__panel {
    background-color: var(--color-crema-50);
    display: grid;
    place-items: center;
  }

  .hero--split .hero__inner {
    max-width: 34rem;
    padding: 2.75rem 1.5rem 3.5rem;
  }

  /* ---------- bloque: banda sólida anclada abajo ---------- */

  .hero--bloque {
    background-color: var(--color-tierra-900);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero--bloque .hero__panel {
    background-color: var(--color-tierra-950);
    padding: 2.5rem 1.5rem 2.75rem;
  }

  .hero--bloque .hero__inner {
    max-width: 46rem;
    margin: 0 auto;
  }

  /* ---------- indicador de scroll ---------- */

  .hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    color: color-mix(in oklch, var(--color-crema-100) 70%, transparent);
  }

  .hero__scroll-linea {
    display: block;
    width: 1px;
    height: 2.75rem;
    background-color: color-mix(in oklch, var(--color-crema-100) 30%, transparent);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-linea::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background-color: var(--color-crema-100);
    animation: hero-scroll 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes hero-scroll {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(250%);
    }
  }

  .hero__scroll-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  /* ============================================================
     PANTALLAS GRANDES
     ============================================================ */

  @media (min-width: 768px) {
    .hero--completo .hero__inner {
      padding: 8rem 2rem 6.5rem;
    }

    .hero--marco {
      padding: 1.25rem;
    }

    .hero--marco .hero__media {
      inset: 1.25rem;
      border-radius: 0.5rem;
    }

    .hero--marco .hero__inner {
      padding: 7rem 2rem 6rem;
    }

    .hero__scroll {
      bottom: 2.25rem;
    }

    .hero__scroll-linea {
      height: 3.5rem;
    }
  }

  /* El split pasa a dos columnas: texto a la izquierda, imagen a la derecha */
  @media (min-width: 900px) {
    .hero--split {
      grid-template-rows: none;
      grid-template-columns: 1fr 1.15fr;
    }

    .hero--split .hero__media {
      grid-column: 2;
      grid-row: 1;
    }

    .hero--split .hero__panel {
      grid-column: 1;
      grid-row: 1;
    }

    .hero--split .hero__inner {
      max-width: 31rem;
      padding: 7rem 3.5rem 4rem 3rem;
    }

    /* La banda pasa a ser una tarjeta flotante sobre la foto */
    .hero--bloque .hero__panel {
      width: min(92%, 46rem);
      margin: 0 auto 3rem;
      border-radius: 0.5rem;
      padding: 3rem 3.5rem;
      background-color: color-mix(in oklch, var(--color-tierra-950) 90%, transparent);
      backdrop-filter: blur(6px);
    }
  }

  /* En pantallas bajas el indicador choca con los CTAs */
  @media (max-height: 700px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-linea::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
