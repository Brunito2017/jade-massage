---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Pie from '../components/Pie.astro';
import { SITE } from '../data/site';

interface Props {
  /** Header transparente sobre el hero, sólido al scrollear. */
  heroTransparente?: boolean;
}

const { heroTransparente = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-tierra-900 focus:text-crema-50 focus:px-4 focus:py-2 focus:rounded"
    >
      Saltar al contenido
    </a>

    <Header heroTransparente={heroTransparente} />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Pie />
  </body>
</html>
