---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SEO from '../components/SEO.astro';
import Hero from '../components/Hero.astro';
import BarraBeneficios from '../components/BarraBeneficios.astro';
import type { Beneficio } from '../components/BarraBeneficios.astro';
import IntroCentro from '../components/IntroCentro.astro';
import SeccionServicios from '../components/SeccionServicios.astro';
import SobreRoxana from '../components/SobreRoxana.astro';
import PreguntasFrecuentes from '../components/PreguntasFrecuentes.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE, whatsappLink } from '../data/site';
import { faqSchema, negocioLocal } from '../data/schema';
import { VARIANTES_HERO, type VarianteHero } from '../data/hero';

/** Variante de hero elegida para la home. */
const varianteHero: VarianteHero = 'completo';

/**
 * PROVISIONAL: hotlink desde Pinterest, sin licencia verificada para uso comercial
 * y dependiente de que i.pinimg.com no bloquee el acceso ni cambie la URL.
 * Reemplazar por foto propia de Roxana o una libre antes de publicar.
 */
const IMAGEN_HERO = 'https://i.pinimg.com/736x/e1/4e/08/e14e08b00346470ac7b345320442b302.jpg';
const titulo = 'Masoterapia y estética integral en La Florida | Jade Belleza y Spa';
const descripcion =
  'Centro de masoterapia clínica y estética integral en La Florida, Santiago. Masaje descontracturante, drenaje linfático y limpieza facial profunda. Agenda por WhatsApp.';

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.prioridad - b.data.prioridad
);
const activos = servicios.filter((s) => s.data.activo);
const inactivos = servicios.filter((s) => !s.data.activo);

/** Franja que va dentro de la onda, al pie del hero. */
const beneficios: Beneficio[] = [
  { icono: 'hoja', texto: 'Masoterapia clínica' },
  { icono: 'loto', texto: 'Estética integral' },
  { icono: 'corazon', texto: 'Tu bienestar, primero' },
];

/**
 * Diferenciadores. Viven dentro de "Sobre Roxana" y no en una sección aparte:
 * el argumento de Jade es quién atiende, y separarlos de la persona los
 * volvía una lista de virtudes abstractas.
 */
const motivos = [
  {
    titulo: 'Enfoque clínico',
    texto:
      'Cada sesión parte de una evaluación: se identifica la zona a tratar y se define el enfoque antes de empezar.',
  },
  {
    titulo: 'Atención personalizada',
    texto:
      'No hay un protocolo fijo. El trabajo se adapta a cómo llegás ese día y a lo que tu cuerpo necesita.',
  },
  {
    titulo: 'Un espacio de calma',
    texto:
      'Un ambiente tranquilo y con hora agendada, para que la sesión sea un paréntesis real en la semana.',
  },
];

/**
 * Preguntas reales, sin placeholders: cada respuesta resuelve una duda que
 * frena la reserva (ubicación, agenda, precio, elección del servicio). El
 * mismo arreglo alimenta el bloque visible y el JSON-LD de FAQPage.
 */
const faq = [
  {
    pregunta: '¿Dónde queda Jade Belleza y Spa?',
    respuesta: `En ${SITE.direccion.calle}, ${SITE.direccion.comuna}, Santiago. Atendemos con hora agendada.`,
  },
  {
    pregunta: '¿Cómo agendo una hora?',
    respuesta: `Escribinos por WhatsApp al ${SITE.telefono} y coordinamos día y horario.`,
  },
  {
    pregunta: '¿Cuánto cuestan los servicios?',
    respuesta:
      'Los valores se consultan directamente por WhatsApp, según el servicio y la zona a tratar.',
  },
  {
    pregunta: '¿No sabés qué servicio elegir?',
    respuesta:
      'Escribinos y te orientamos: contanos qué molestias tenés y te proponemos el tratamiento más adecuado.',
  },
];

/** El negocio va siempre; el FAQPage solo si hay preguntas. */
const faqLd = faqSchema(faq);
const schema = faqLd ? [negocioLocal(), faqLd] : [negocioLocal()];
---

<Base heroTransparente={VARIANTES_HERO[varianteHero].headerTransparente}>
  <SEO
    slot="head"
    titulo={titulo}
    descripcion={descripcion}
    schema={schema}
  />

  <Hero
    variante={varianteHero}
    imagen={IMAGEN_HERO}
    eyebrow={`${SITE.comuna}, Santiago`}
    titulo="Masoterapia y estética integral en La Florida"
    subtitulo="Un espacio dedicado al cuidado del cuerpo y la calma. Masaje descontracturante, drenaje linfático y tratamientos faciales, con atención personalizada."
    ctaTexto="Agendar por WhatsApp"
    ctaHref={whatsappLink('Hola, me gustaría agendar una hora.')}
  >
    <BarraBeneficios slot="cierre" beneficios={beneficios} />
  </Hero>

  <IntroCentro />

  <SeccionServicios servicios={activos} inactivos={inactivos} />

  <SobreRoxana motivos={motivos} />

  <PreguntasFrecuentes items={faq} />

  <CtaFinal />
</Base>
