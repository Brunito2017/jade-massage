---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SEO from '../../components/SEO.astro';
import { SITE, whatsappLink } from '../../data/site';
import { servicioSchema, breadcrumbSchema, faqSchema } from '../../data/schema';

export const getStaticPaths = (async () => {
  const servicios = await getCollection('servicios');
  return servicios
    .filter((s) => s.data.activo)
    .map((servicio) => ({
      params: { slug: servicio.data.slug },
      props: { servicio },
    }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;
const s = servicio.data;

const otros = (await getCollection('servicios'))
  .filter((o) => o.data.activo && o.data.slug !== s.slug)
  .sort((a, b) => a.data.prioridad - b.data.prioridad);

const schemas = [
  servicioSchema({ nombre: s.nombre, descripcion: s.descripcion, slug: s.slug }),
  breadcrumbSchema([
    { nombre: 'Inicio', url: '/' },
    { nombre: 'Servicios', url: '/servicios/' },
    { nombre: s.nombre, url: `/servicios/${s.slug}/` },
  ]),
  faqSchema(s.faq),
].filter(Boolean) as Record<string, unknown>[];
---

<Base>
  <SEO
    slot="head"
    titulo={`${s.titulo} | ${SITE.nombre}`}
    descripcion={s.descripcion}
    schema={schemas}
  />

  <!-- HERO -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16">
    <nav aria-label="Migas de pan" class="text-sm text-tierra-500 mb-8">
      <a href="/" class="hover:text-tierra-700 transition-colors">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/servicios/" class="hover:text-tierra-700 transition-colors">Servicios</a>
      <span class="mx-2">/</span>
      <span>{s.nombre}</span>
    </nav>

    <div class="grid gap-14 lg:grid-cols-[1.2fr_1fr] items-start">
      <div>
        <p class="text-xs uppercase tracking-widest text-tierra-400 mb-5">
          {s.categoria === 'masoterapia' ? 'Masoterapia' : 'Estética'}
        </p>
        <h1 class="font-serif text-4xl md:text-6xl text-tierra-900 leading-[1.1] mb-8">
          {s.titulo}
        </h1>
        <p class="text-lg text-tierra-700 leading-relaxed mb-10 max-w-xl">
          {s.descripcion}
        </p>
        <a
          href={whatsappLink(`Hola, me gustaría consultar por ${s.nombre.toLowerCase()}.`)}
          target="_blank"
          rel="noopener"
          class="inline-block bg-tierra-900 text-crema-50 px-8 py-4 rounded-full hover:bg-tierra-700 transition-colors"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <div class="bg-tierra-200 aspect-[4/5] rounded-sm grid place-items-center">
        <!-- PLACEHOLDER: imagen real del servicio -->
        <p class="text-tierra-500 text-sm tracking-widest uppercase px-6 text-center">
          [Imagen: {s.nombre}]
        </p>
      </div>
    </div>
  </section>

  <!-- QUÉ ES -->
  <section class="bg-crema-100 py-[var(--spacing-seccion)]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-8">
        ¿En qué consiste?
      </h2>
      <p class="text-tierra-700 leading-relaxed mb-5">
        [PLACEHOLDER: 2-3 párrafos explicando la técnica. Qué hace sobre el cuerpo,
        cómo se aplica, en qué se diferencia de un masaje genérico. Este bloque es
        clave para posicionar — es el contenido que Google indexa.]
      </p>
      <p class="text-tierra-700 leading-relaxed">
        [PLACEHOLDER: segundo párrafo]
      </p>
      <p class="text-sm text-tierra-500 mt-8">
        Duración de la sesión: {s.duracion}
      </p>
    </div>
  </section>

  <!-- PARA QUIÉN ES -->
  <section class="py-[var(--spacing-seccion)]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-8">¿Para quién es?</h2>
      <ul class="space-y-4">
        {
          s.paraQuienEs.map((item) => (
            <li class="flex gap-4 text-tierra-700 leading-relaxed">
              <span class="text-tierra-400 mt-1" aria-hidden="true">—</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="bg-crema-100 py-[var(--spacing-seccion)]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-8">Beneficios</h2>
      <ul class="space-y-4">
        {
          s.beneficios.map((item) => (
            <li class="flex gap-4 text-tierra-700 leading-relaxed">
              <span class="text-tierra-400 mt-1" aria-hidden="true">—</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CÓMO ES LA SESIÓN -->
  <section class="py-[var(--spacing-seccion)]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-8">Cómo es la sesión</h2>
      <p class="text-tierra-700 leading-relaxed">
        [PLACEHOLDER: qué esperar al llegar, cómo prepararse, qué llevar, cómo se
        desarrolla. Reducir la incertidumbre ayuda a que la persona se decida.]
      </p>
    </div>
  </section>

  <!-- CONTRAINDICACIONES -->
  <section class="bg-crema-100 py-[var(--spacing-seccion)]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-8">
        Cuándo no realizarlo
      </h2>
      <p class="text-tierra-700 leading-relaxed mb-6">
        Ante cualquiera de estas situaciones, consultanos antes de agendar:
      </p>
      <ul class="space-y-4">
        {
          s.contraindicaciones.map((item) => (
            <li class="flex gap-4 text-tierra-700 leading-relaxed">
              <span class="text-tierra-400 mt-1" aria-hidden="true">—</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="text-sm text-tierra-500 mt-8">
        Esta información es orientativa y no reemplaza una consulta médica.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  {
    s.faq.length > 0 && (
      <section class="py-[var(--spacing-seccion)]">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="font-serif text-3xl text-tierra-900 mb-10">
            Preguntas frecuentes
          </h2>
          <div class="space-y-2">
            {s.faq.map((item) => (
              <details class="group bg-crema-100 rounded-sm border border-tierra-900/8">
                <summary class="cursor-pointer list-none px-6 py-5 flex justify-between items-center gap-4 font-serif text-lg text-tierra-900">
                  {item.pregunta}
                  <span class="text-tierra-400 group-open:rotate-45 transition-transform text-2xl leading-none">
                    +
                  </span>
                </summary>
                <p class="px-6 pb-6 text-tierra-700 leading-relaxed">
                  {item.respuesta}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- AUTORIDAD -->
  <section class="bg-crema-100 py-16">
    <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <div class="w-20 h-20 rounded-full bg-tierra-300 shrink-0 grid place-items-center">
        <!-- PLACEHOLDER: foto real de Roxana -->
        <span class="text-tierra-600 text-xs text-center px-2">[foto]</span>
      </div>
      <div>
        <p class="text-sm text-tierra-500 mb-2">Quién realiza este tratamiento</p>
        <p class="font-serif text-xl text-tierra-900 mb-2">Roxana</p>
        <p class="text-sm text-tierra-700 leading-relaxed">
          Masoterapeuta clínica y esteticista integral.{' '}
          <a href="/sobre-roxana/" class="text-tierra-600 underline underline-offset-4">
            Conocer su formación
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- OTROS SERVICIOS -->
  <section class="py-[var(--spacing-seccion)]">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-tierra-900 mb-10">Otros servicios</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          otros.map((o) => (
            <a
              href={`/servicios/${o.data.slug}/`}
              class="group block bg-crema-100 p-8 rounded-sm border border-tierra-900/8 hover:border-tierra-900/20 transition-all"
            >
              <h3 class="font-serif text-xl text-tierra-900 mb-2 group-hover:text-tierra-600 transition-colors">
                {o.data.nombre}
              </h3>
              <p class="text-sm text-tierra-700 leading-relaxed">
                {o.data.descripcion}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div class="bg-tierra-900 rounded-sm px-8 py-16 md:px-16 text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-crema-50 mb-6">
        Agendá tu {s.nombre.toLowerCase()}
      </h2>
      <p class="text-crema-200/80 leading-relaxed mb-10 max-w-xl mx-auto">
        Escribinos y coordinamos el día y la hora que mejor te acomode.
      </p>
      <a
        href={whatsappLink(`Hola, me gustaría agendar ${s.nombre.toLowerCase()}.`)}
        target="_blank"
        rel="noopener"
        class="inline-block bg-crema-50 text-tierra-900 px-10 py-4 rounded-full hover:bg-crema-200 transition-colors"
      >
        {SITE.telefono}
      </a>
    </div>
  </section>
</Base>
